<?xml version="1.0" encoding="utf-8"?>
<!-- Dark card + red/coral glow, used behind the RUNNING pose. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#121826" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="90dp"
                android:centerX="0.28"
                android:centerY="0.5"
                android:startColor="#55ef4444"
                android:centerColor="#22ef4444"
                android:endColor="#00ef4444" />
        </shape>
    </item>
</layer-list>

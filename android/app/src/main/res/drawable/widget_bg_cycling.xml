<?xml version="1.0" encoding="utf-8"?>
<!-- Dark card + violet glow, used behind the CYCLING (top-tier) pose. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#121826" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="90dp"
                android:centerX="0.28"
                android:centerY="0.5"
                android:startColor="#558b5cf6"
                android:centerColor="#228b5cf6"
                android:endColor="#008b5cf6" />
        </shape>
    </item>
</layer-list>
